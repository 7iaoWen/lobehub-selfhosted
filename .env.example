# =====================================================
# LobeHub 私有化部署 —— 环境变量示例（占位符）
# 用法：cp .env.example .env，然后填入真实值
# =====================================================

# ----- 数据库 -----
POSTGRES_PASSWORD=change_me_strong_password

# ----- 对象存储 MinIO（与 S3_SECRET_ACCESS_KEY 一致）-----
MINIO_ROOT_PASSWORD=change_me_strong_password

# ----- 应用密钥（生成后永久固定）-----
# 生成：openssl rand -base64 32
KEY_VAULTS_SECRET=change_me_openssl_rand_base64_32
BETTER_AUTH_SECRET=change_me_openssl_rand_base64_32
JWKS_KEY=change_me_jwks_json

# ----- 对外地址 -----
# 备案前用 http://服务器IP:3210；备案后改为 https://域名
APP_URL=https://your-domain.com
S3_PUBLIC_DOMAIN=your-domain.com:9000

# ----- AI 服务 -----
DEEPSEEK_API_KEY=your_deepseek_api_key_here
ZHIPU_API_KEY=xxxxxxxx.xxxxxxxx
SEARCH1API_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ----- 访问控制（留空=任何人可注册，危险）-----
AUTH_ALLOWED_EMAILS=you@example.com